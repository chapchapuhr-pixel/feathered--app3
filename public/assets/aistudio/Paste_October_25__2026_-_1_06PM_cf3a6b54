## 5. Video Pipeline (exact — no /api/reels call)

```tsx
else if (list.length) {
  const isVideoFile = (f: File) => {
    if (!f) return false;
    const t = String(f.type || '').toLowerCase();
    const n = String(f.name || '').toLowerCase();
    return t.startsWith('video/') || /\.(mp4|webm|mov|m4v|m3u8|3gp|avi|mkv)$/i.test(n);
  };
  const isVideo = meta?.type === 'video' || list.some(isVideoFile);

  setPostUploadState(prev => prev ? ({
    ...prev,
    progress: 40,
    secondaryStatus: isVideo
      ? 'Uploading and processing video...'
      : 'Uploading media files...',
  }) : null);

  if (isVideo) {
    const videoFile = list.find(isVideoFile) || list[0];
    let thumbFile: File | null = meta?.thumbnailFile || null;

    // --- Dual browser-side compression (1080p + 720p) ---
    let compressed: CompressedVideoResult | null = meta?.compressedVideos || null;
    if (!compressed && meta?.compressedVideosPromise) {
      try { compressed = await meta.compressedVideosPromise; } catch (e) {}
    }
    if (!compressed && videoFile) {
      try { compressed = await compressVideoDual(videoFile); } catch (err) {}
    }

    // --- Thumbnail fallback ---
    if (!thumbFile && compressed?.thumbnailFile) thumbFile = compressed.thumbnailFile;
    if (!thumbFile && videoFile) {
      try { const res = await generateVideoThumbnail(videoFile); thumbFile = res.file; } catch {}
    }

    const file1080 = compressed?.high1080pFile || videoFile;
    const file720  = compressed?.low720pFile  || videoFile;

    // --- Upload 4 assets in parallel to R2 (media.featheredsocial.site) ---
    const [origUp, high1080Up, low720Up, thumbUp] = await Promise.all([
      uploadToCloudflareR2(videoFile, 'posts/videos/original'),
      uploadToCloudflareR2(file1080,  'posts/videos/1080p'),
      uploadToCloudflareR2(file720,   'posts/videos/720p'),
      thumbFile ? uploadToCloudflareR2(thumbFile, 'posts/thumbnails') : Promise.resolve(null),
    ]);

    const origUrl     = origUp.url;        // https://media.featheredsocial.site/posts/videos/original/...
    const high1080Url = high1080Up.url;    // https://media.featheredsocial.site/posts/videos/1080p/...
    const low720Url   = low720Up.url;      // https://media.featheredsocial.site/posts/videos/720p/...
    let   thumbUrl    = thumbUp?.url || null; // https://media.featheredsocial.site/posts/thumbnails/...

    // Thumbnail safety: retry if missing or wrong MIME
    if (!thumbUrl && thumbFile) {
      try {
        const retry = await uploadToCloudflareR2(thumbFile, 'posts/thumbnails');
        thumbUrl = retry?.url || null;
      } catch {}
    }
    const isInvalidThumb =
      !thumbUrl || thumbUrl.match(/\.(mp4|webm|mov|m4v|3gp|avi|mkv)(\?|$)/i);
    if (isInvalidThumb && videoFile) {
      try {
        const res = await generateVideoThumbnail(videoFile);
        if (res?.file) {
          const freshUp = await uploadToCloudflareR2(res.file, 'posts/thumbnails');
          thumbUrl = freshUp?.url || null;
        }
      } catch {}
    }

    // ---- Final asset mapping (all URLs on media.featheredsocial.site) ----
    const primaryPlaybackUrl = low720Url || origUrl;

    media_url   = primaryPlaybackUrl;
    media_type  = 'video';

    media_urls  = thumbUrl
      ? [origUrl, high1080Url, low720Url, thumbUrl]
      : [origUrl, high1080Url, low720Url];

    media_types = thumbUrl
      ? ['video', 'video', 'video', 'image']
      : ['video', 'video', 'video'];

    media_meta = [{
      original:      origUrl,
      '1080':        high1080Url,
      '720':         low720Url,
      thumbnail_url: thumbUrl,
      thumb:         thumbUrl,
      feed:          low720Url,
      full:          high1080Url,
      type:          'video',
      width:         compressed?.highWidth  || undefined,
      height:        compressed?.highHeight || undefined,
      duration:      compressed?.duration   || undefined,
    }];
  } else {
    // Generic non-video files
    const ups = await Promise.all(list.map((f) => uploadToCloudflareR2(f)));
    media_urls  = ups.map((u) => u.url).filter(Boolean);
    media_types = ups.map((u) => u.type).filter(Boolean);
    media_url   = media_urls[0] ?? null;
    media_type  = media_types[0] ?? null;
  }
}
